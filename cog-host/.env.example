# Copy to .env, chmod 600, and fill in only the keys you have.
# Modules whose key is missing skip cleanly - nothing here is required to run Cog Host.

# --- Network / auth ---
BIND_LAN=false
# argon2 hash of a login password, required only when BIND_LAN=true
AUTH_PASSWORD_HASH=

# --- Guardrails ---
RATE_LIMIT_PER_HOUR=10
HISTORY_RETENTION_DAYS=30
SHOW_SENSITIVE=false
ENABLE_HOLEHE=false

# --- Keyed API modules (see PLAN.md section 3) ---
HUNTER_API_KEY=
EMAILREP_API_KEY=
VERIPHONE_API_KEY=
TAVILY_API_KEY=
GRAVATAR_API_KEY=
GITHUB_TOKEN=

# --- Local services ---
PHONEINFOGA_URL=http://127.0.0.1:5000
